# Hue — optional. If set, the Hue panel connects automatically instead of
# showing the one-time bridge-setup form. Since the bridge is only reachable
# on the home network, these are safe to expose to the client (NEXT_PUBLIC_).
NEXT_PUBLIC_HUE_BRIDGE_IP=
NEXT_PUBLIC_HUE_APP_KEY=

# Spotify — optional. If set, the Spotify panel connects automatically instead
# of asking for a Client ID. It's a PKCE public client, so there's no secret
# to keep server-side. Create it at developer.spotify.com/dashboard and add
# <your-deployed-url>/spotify/callback (and, for local dev,
# http://127.0.0.1:3000/spotify/callback) as redirect URIs.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Recipe library — required. Run supabase/migrations/0001_recipes.sql once
# against the Wardrobe Edit Supabase project (org Nina, project
# the-wardrobe-edit), then fill these in from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never exposed to the browser — used by /api/recipes to
# bypass RLS when inserting a new recipe or uploading its photo.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Whatever passcode you want the upload page to require.
RECIPE_UPLOAD_PASSCODE=

# Dashboard access PIN — optional but recommended once this is deployed to a
# public Vercel URL. Both required together; if either is unset, the
# dashboard stays open (no gate) rather than locking you out of your own
# deployment. DASHBOARD_SESSION_SECRET is just a random string you generate
# once (e.g. `openssl rand -hex 32`) — it signs the "unlocked" cookie so
# stealing the cookie alone can't be used to derive the PIN.
DASHBOARD_PIN=
DASHBOARD_SESSION_SECRET=
